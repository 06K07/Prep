# Copy to .env and export (e.g. `set -a; . ./.env; set +a`). Everything is optional.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# AI helper (pick one; Gemini has a free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
AI_QUERY_LIMIT=10

# Compiler / sandbox
CPP_STD=c++17
MAX_CONCURRENT_RUNS=2
MEMORY_LIMIT_MB=512

# Test layout
DSA_QUESTIONS=2
DSA_MINUTES_PER_QUESTION=35
REPO_MINUTES=45

# Set to true only when running behind a reverse proxy you control
TRUST_PROXY=false
